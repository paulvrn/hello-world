<dl class="recap">
  <dt>Référence</dt><dd><strong><%= project.ref %></strong></dd>
  <dt>Projet</dt><dd><%= project.title %></dd>
  <dt>Société</dt><dd><%= project.contact_company %></dd>
  <dt>Contact</dt><dd><%= project.contact_name %> · <%= project.contact_email %><%= project.contact_phone ? ' · ' + project.contact_phone : '' %></dd>
  <dt>Lieu de fabrication</dt><dd><%= REGIONS[project.region] %></dd>
  <dt>Quantité</dt><dd><%= project.quantity %><%= project.lot_cadence ? ' · ' + project.lot_cadence : '' %></dd>
  <dt>Maturité</dt><dd><%= MATURITIES[project.maturity] %></dd>
  <dt>Cadre de la demande</dt><dd><%= CONTEXTS[project.context] %></dd>
  <dt>Délai souhaité</dt><dd><%= project.desired_deadline ? fmtDate(project.desired_deadline) : 'Non précisé' %></dd>
  <dt>Prix cible</dt><dd><%= project.target_price || 'Non précisé' %></dd>
  <dt>Norme de fabrication</dt><dd><%= QUALITY_STANDARDS[project.quality_standard] || 'Non précisée' %></dd>
  <dt>Tests exigés</dt><dd><%= listOf(project.tests_required, TESTS).map(k => TESTS[k]).join(', ') || 'Non précisés' %></dd>
  <dt>Certifications exigées</dt><dd><%= listOf(project.certifications_required, CERTIFICATIONS).map(k => CERTIFICATIONS[k]).join(', ') || 'Aucune' %></dd>
  <dt>Composants</dt><dd><%= COMPONENT_SUPPLY[project.components_supply] || 'Non précisé' %></dd>
  <dt>Lieu de livraison</dt><dd><%= project.delivery_place || 'Non précisé' %></dd>
  <dt>Contraintes réglementaires</dt><dd class="pre"><%= project.regulatory_constraints || '—' %></dd>
  <dt>Précisions</dt><dd class="pre"><%= project.notes || '—' %></dd>
  <dt>Documents</dt>
  <dd>
    <ul class="files">
      <% files.forEach(f => { %>
      <li><span class="tag"><%= FILE_KINDS[f.kind] %></span> <%= f.original_name %> <small class="muted"><%= fmtSize(f.size) %></small></li>
      <% }) %>
    </ul>
  </dd>
</dl>
