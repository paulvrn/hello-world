<%- include('partials/head', { title: 'Consultation ' + project.ref }) %>
<h1>Consultation <%= project.ref %></h1>
<p class="muted">Bonjour <%= supplier.company %>, voici le projet de câblage pour lequel nous sollicitons votre offre.
  <% if (consultation.panel_size) { %><strong>Consultation restreinte à <%= consultation.panel_size %> fabricant<%= consultation.panel_size > 1 ? 's' : '' %>.</strong><% } %></p>

<% if (!ndaAccepted) { %>
<form method="post" action="/consultation/<%= consultation.token %>/engagement" class="card card-action form">
  <h2>Avant d'accéder aux documents</h2>
  <%- include('partials/nda') %>
  <label class="check consent"><input type="checkbox" name="nda" value="1" required> J'accepte cet engagement au nom de <%= supplier.company %>.</label>
  <button class="btn btn-primary">Accepter et accéder à la consultation</button>
</form>
<% } %>

<div class="card">
  <h2>Le besoin</h2>
  <p class="pre"><%= project.supplier_brief %></p>
  <h3>Documents</h3>
  <% if (!ndaAccepted) { %><p class="muted">Les documents sont accessibles après acceptation de l'engagement de confidentialité.</p>
  <% } else if (!files.length) { %><p class="muted">Les documents seront mis à disposition prochainement.</p><% } %>
  <ul class="files">
    <% files.forEach(f => { %>
    <li><span class="tag"><%= FILE_KINDS[f.kind] %></span> <a href="/consultation/<%= consultation.token %>/fichiers/<%= f.id %>?<%= f.query %>"><%= f.name %></a> <small class="muted"><%= fmtSize(f.size) %></small></li>
    <% }) %>
  </ul>
  <p class="hint">Documents confidentiels : merci de ne pas les diffuser. Les liens de téléchargement expirent au bout d'une heure ; rechargez cette page pour en obtenir de nouveaux.</p>
</div>

<% if (ndaAccepted) { %>
<div class="card" id="questions">
  <h2>Questions / réponses</h2>
  <p class="hint">Les réponses sont partagées avec tous les fabricants consultés, sans indiquer qui a posé la question, pour que chacun chiffre sur la même base.</p>
  <% if (!questions.length) { %><p class="muted">Aucune question pour le moment.</p><% } %>
  <ul class="qa">
    <% questions.forEach(q => { %>
    <li><div class="q"><%= q.question %><% if (q.mine) { %> <small class="muted">(votre question)</small><% } %></div>
      <div class="a"><%= q.answer || 'Réponse en attente…' %></div></li>
    <% }) %>
  </ul>
  <% if (!project.closed) { %>
  <form method="post" action="/consultation/<%= consultation.token %>/questions" class="form">
    <label>Poser une question<textarea name="question" rows="2" required></textarea></label>
    <button class="btn btn-small">Envoyer la question</button>
  </form>
  <% } %>
</div>
<% } %>

<% if (['quoted', 'declined', 'won', 'lost'].includes(consultation.status)) { %>
<div class="card">
  <h2>Votre réponse</h2>
  <% if (consultation.status !== 'declined') { %>
  <dl class="recap"><dt>Prix</dt><dd><%= consultation.price %></dd><dt>Délai</dt><dd><%= consultation.lead_time %></dd>
  <% if (consultation.comment) { %><dt>Commentaire</dt><dd class="pre"><%= consultation.comment %></dd><% } %></dl>
  <% } else { %><p>Vous avez décliné cette consultation.</p><% } %>
  <% if (consultation.status === 'won') { %><p><span class="status status-won">Offre retenue</span></p><% } %>
  <% if (consultation.status === 'lost') { %><p><span class="status status-lost">Offre non retenue</span></p><% } %>
  <% if (consultation.feedback) { %><p class="pre quote"><%= consultation.feedback %></p><% } %>
</div>
<% } else if (project.closed) { %>
<div class="card"><p>Cette consultation est clôturée.</p></div>
<% } else if (ndaAccepted) { %>
<form method="post" action="/consultation/<%= consultation.token %>" class="card form">
  <h2>Votre offre</h2>
  <div class="grid2">
    <label>Prix *<input name="price" placeholder="ex. 38 € HT / pièce, outillage 1 200 €"></label>
    <label>Délai *<input name="lead_time" placeholder="ex. 4 semaines après commande"></label>
  </div>
  <label>Commentaire<textarea name="comment" rows="3"></textarea></label>
  <div class="row">
    <button class="btn btn-primary" name="action" value="quote">Envoyer mon offre</button>
    <button class="btn" name="action" value="decline" formnovalidate>Décliner</button>
  </div>
</form>
<% } %>
<%- include('partials/foot') %>
